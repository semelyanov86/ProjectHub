<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="projecthub"
        Arguments=""
        InstallLocation="C:\Program Files\ProjectHub\ProjectHub">
    </Installer>
    <PackageInformation
        PackageName="ProjectHub"
        PackageDisplayName="ProjectHub"
        PublisherName="CN=ProjectHub"
        PublisherDisplayName="ProjectHub"
        Version="1.0.0.0"
        PackageDescription="Lightweight desktop project manager for developers">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.semelyanov86.projecthub"
                Description="Lightweight desktop project manager for developers"
                DisplayName="ProjectHub"
                ExecutableName="projecthub"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ProjectHub</DisplayName>
            <PublisherDisplayName>ProjectHub</PublisherDisplayName>
            <Description>Lightweight desktop project manager for developers</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="projecthub.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
