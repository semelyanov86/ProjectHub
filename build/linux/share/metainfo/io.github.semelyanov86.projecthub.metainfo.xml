<component type="desktop-application">
  <id>io.github.semelyanov86.projecthub</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>ProjectHub</name>
  <summary>Manage and open development projects</summary>
  <description>
    <p>
      ProjectHub keeps a list of your local development projects and opens them in one
      click: in Zed or Sublime Text, in Ghostty or another terminal, or in the file manager.
    </p>
    <ul>
      <li>Favorites, recently opened projects and instant search</li>
      <li>Read-only Git branch and uncommitted-changes indicators</li>
      <li>Drag and drop folders, JSON import and export</li>
      <li>System tray menu with recent projects</li>
      <li>Local-first: plain JSON files in ~/.config/projecthub, no accounts, no telemetry</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.semelyanov86.projecthub.desktop</launchable>
  <developer id="io.github.semelyanov86">
    <name>Sergey Emelyanov</name>
  </developer>
